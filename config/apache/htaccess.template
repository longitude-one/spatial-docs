# Generated by scripts/apache-negotiation.mjs. Deploy this file with the corpus.
# Apache 2.4: mod_rewrite, mod_headers, mod_mime; AllowOverride FileInfo Options=MultiViews.
Options -MultiViews
AddType text/html .html
AddType "text/plain; charset=UTF-8" .txt
AddType "text/markdown; charset=UTF-8" .md
AddDefaultCharset UTF-8
RewriteEngine On

# Crawlable alternate representations must not compete with canonical HTML.
<FilesMatch "\.md$">
Header always set X-Robots-Tag "noindex"
</FilesMatch>
Header always set X-Robots-Tag "noindex" env=DOC_NEGOTIATED
Header always set X-Robots-Tag "noindex" env=REDIRECT_DOC_NEGOTIATED

# Immutable filenames change with their content; document identities remain fresh.
<FilesMatch "(?:\.[a-f0-9]{6,}\.(?:js|css)|^search-index-[a-f0-9]+\.json)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json text/markdown text/plain image/svg+xml
</IfModule>

# Explicit representations, other physical files, and directories bypass negotiation.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]
RewriteRule (^|/)[^/]*\. - [END]

# An endpoint requires its complete pair; no variant discovery or fallback.
RewriteCond %{REQUEST_FILENAME}.html !-f [OR]
RewriteCond %{REQUEST_FILENAME}.md !-f
RewriteRule ^ - [END]
RewriteRule ^ - [E=DOC_NEGOTIATED:1]
Header always merge Vary Accept env=DOC_NEGOTIATED
Header always merge Vary Accept env=REDIRECT_DOC_NEGOTIATED

# GENERATED ACCEPT QUALITY RULES

# An absent or empty Accept header permits both representations.
RewriteCond %{HTTP:Accept} ^$
RewriteRule ^ - [E=DOC_HTML_Q:1000,E=DOC_MARKDOWN_Q:1000]

RewriteCond expr "reqenv('DOC_MARKDOWN_Q') -gt reqenv('DOC_HTML_Q')"
RewriteRule ^(.+)$ $1.md [END]
RewriteCond expr "reqenv('DOC_HTML_Q') -gt 0"
RewriteRule ^(.+)$ $1.html [END]
RewriteRule ^ - [R=406,END]
