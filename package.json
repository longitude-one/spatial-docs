{
  "name": "spatial-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prestart": "node scripts/generate-legal-notice.mjs && node scripts/export-markdown.mjs",
    "start": "docusaurus start",
    "start:local": "node scripts/with-test-legal.mjs npm start",
    "build": "node scripts/build-publication.mjs",
    "build:local": "node scripts/with-test-legal.mjs npm run build",
    "serve": "node scripts/serve-publication.mjs",
    "test": "node --test",
    "stop": "node scripts/stop-server.mjs",
    "validate:assets": "node scripts/generate-legal-notice.mjs && node scripts/export-markdown.mjs --validate-assets",
    "validate:corpus": "node scripts/validate-corpus.mjs",
    "validate:determinism": "node scripts/check-determinism.mjs"
  },
  "engines": {
    "node": ">=20.0",
    "npm": ">=10.0"
  },
  "dependencies": {
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "github-slugger": "^2.0.0",
    "js-yaml": "^4.3.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sax": "1.6.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.3",
    "parse5": "^7.3.0"
  }
}
